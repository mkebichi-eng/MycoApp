{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web_preview",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk"
    ],
    "redirects": [
      {
        "source": "/MycoTrackPro.apk",
        "destination": "https://github.com/mkebichi-eng/MycoApp/raw/main/MycoTrackPro.apk",
        "type": 302
      },
      {
        "source": "/apk",
        "destination": "https://github.com/mkebichi-eng/MycoApp/raw/main/MycoTrackPro.apk",
        "type": 302
      },
      {
        "source": "/download",
        "destination": "https://github.com/mkebichi-eng/MycoApp/raw/main/MycoTrackPro.apk",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
